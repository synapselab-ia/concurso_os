{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evidence_event.schema.json",
  "title": "EvidenceEvent",
  "type": "object",
  "required": ["schema_version", "event_id", "event_type", "occurred_at", "participant_id", "competition_id", "enrollment_id", "competency_ids", "payload", "provenance"],
  "properties": {
    "schema_version": {"type": "string"},
    "event_id": {"type": "string", "minLength": 1},
    "event_type": {"type": "string", "minLength": 1},
    "occurred_at": {"type": "string", "minLength": 1},
    "participant_id": {"type": "string", "pattern": "^p[0-9]{3,}$"},
    "competition_id": {"type": "string", "minLength": 1},
    "enrollment_id": {"type": "string", "minLength": 1},
    "competency_ids": {"type": "array", "items": {"type": "string"}},
    "payload": {"type": "object"},
    "provenance": {"type": "object"}
  },
  "additionalProperties": true
}
